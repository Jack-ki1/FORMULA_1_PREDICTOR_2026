# F1 Prediction System - Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# Database Configuration
F1_DATABASE_URL=sqlite:///f1_predictor.db

# External APIs (optional)
WEATHER_API_KEY=

# Dashboard Configuration
FLASK_PORT=5000

# Logging
LOG_LEVEL=INFO
