# Everything is optional. Set these in Vercel → Project → Settings → Environment Variables.
DATA_MODE=auto               # auto = live Jolpica data with bundled-snapshot fallback; seed = offline only
SEASON=2026
CACHE_TTL=600                # seconds live data is cached in memory
LIVE_INTERVAL=300            # refresh interval advertised to clients
MODEL_TYPE=monte_carlo_form  # or monte_carlo
MAX_SIMS=50000               # hard cap on simulations per request
SETTINGS_ADMIN_TOKEN=        # set a long random value to enable the Settings → Backend Configuration saves
CORS_ORIGINS=                # comma-separated origins allowed to call the API cross-origin; blank = same-origin only
                             # (the frontend + API are one origin on Vercel, so blank is correct there). "*" = any website.
