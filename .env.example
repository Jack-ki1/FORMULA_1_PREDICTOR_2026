# ============================================
# F1 PREDICTOR - Vercel Environment Variables
# ============================================
#
# Copy this file to your actual .env or use these values in Vercel's 
# Environment Variables UI
# IMPORTANT: Never commit actual .env files with secrets to Git!
#
# After first deployment, update FRONTEND_ORIGIN with your Vercel URL
# Example: https://f1-predictor-2026.vercel.app

# ============================================
# REQUIRED VARIABLES (Must be set on Vercel)
# ============================================

# Database Connection - Use Supabase or Neon PostgreSQL
# Get this from your Supabase/Neon dashboard
# Vercel Note: SQLite is NOT compatible with Vercel (ephemeral filesystem)
# MUST use external PostgreSQL (Supabase/Neon)
DATABASE_URL=postgresql://user:password@host:5432/f1_predictor

# Secret Key for JWT signing and session management
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to boot with the default value while ENVIRONMENT=production.
SECRET_KEY=your-32-character-random-secret-key-here

# Frontend Origin for CORS
# Set to your Vercel deployment URL after first deploy
FRONTEND_ORIGIN=https://your-app.vercel.app

# ============================================
# PRODUCTION SETTINGS
# ============================================

# Application environment
# Options: development, staging, production
ENVIRONMENT=production

# Debug mode
# Disable in production for security and performance
DEBUG=false

# Application bind address and port
HOST=0.0.0.0
PORT=5000

# ============================================
# CACHE CONFIGURATION
# ============================================

# Redis availability (Vercel Note: Redis is NOT available on Vercel)
REDIS_REQUIRED=false
ENABLE_IN_MEMORY_FALLBACK=true

# Cache TTL settings (seconds)
# Vercel Note: File system is ephemeral, only /tmp persists temporarily
API_CACHE_TTL=300
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=3600

# FastF1 cache configuration
FASTF1_CACHE_ENABLED=True
FASTF1_CACHE_PATH=/tmp/cache/fastf1_cache
MODEL_CACHE_PATH=/tmp/cache/model_cache

# ============================================
# LIVE DATA UPDATES
# ============================================

# Interval for live data updates (seconds)
# Set to 0 to disable live updates
# Vercel Note: Consider function timeout limits when setting this
LIVE_UPDATE_INTERVAL=300
POST_RACE_EVALUATION_ENABLED=True

# ============================================
# AI PROVIDER CONFIGURATION (Optional)
# ============================================

# Choose one: 'huggingface' or 'openai'
AI_PROVIDER=huggingface

# HuggingFace API Key (if using HuggingFace)
# Generate at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-api-key

# OpenAI API Key (if using OpenAI)
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# HuggingFace dataset
HUGGINGFACE_DATASET=tracinginsights/RaceData

# ============================================
# SECURITY & ADMIN
# ============================================

# Admin token for settings API (optional but recommended)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SETTINGS_ADMIN_TOKEN=your-admin-token-here

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTHED=500/hour
RATE_LIMIT_PREDICTIONS=60/hour
RATE_LIMIT_AI=30/hour
RATE_LIMIT_LIVE=120/hour
RATE_LIMIT_EXPORTS=20/hour

# ============================================
# PERFORMANCE TUNING
# ============================================

# Monte Carlo simulation count (balance accuracy vs speed)
# Vercel has 10s timeout on Hobby plan, 60s on Pro
# Adjust based on your Vercel plan
MONTE_CARLO_SIMULATIONS=1000

# Model versioning
DEFAULT_MODEL_VERSION=v1.0
MODEL_VERSION=12.4
FEATURE_VERSION=8
DATASET_VERSION=14
CALIBRATION_VERSION=3.1

# Enable model ensemble predictions
ENABLE_ENSEMBLE=True

# ============================================
# API BASE URLs
# ============================================

JOLPICA_BASE_URL=https://api.jolpica.f1
OPENF1_BASE_URL=https://api.openf1.org

# ============================================
# REPORTS AND EXPORTS
# ============================================

PDF_EXPORT_ENABLED=True
SHARE_CARD_ENABLED=True

# ============================================
# MONITORING (Optional)
# ============================================

MONITORING_ENABLED=true
METRICS_PORT=9090
METRICS_UPDATE_INTERVAL=15

# ============================================
# SEASON CONFIGURATION
# ============================================

SEASON_YEAR=2026

# ============================================
# FEATURE WEIGHTS (defaults matching JSX sliders)
# ============================================

CHAOS_LEVEL_DEFAULT=50
WET_INFLUENCE_DEFAULT=50
RELIABILITY_INFLUENCE_DEFAULT=50
STRATEGY_AGGRESSIVENESS_DEFAULT=50
GRID_WEIGHT_DEFAULT=55

# ============================================
# VERCEL DEPLOYMENT NOTES
# ============================================

# 1. SQLite is NOT compatible with Vercel (ephemeral filesystem)
#    → Must use external PostgreSQL (Supabase/Neon)

# 2. Redis is NOT available on Vercel
#    → Use in-memory cache (already configured above)

# 3. Function timeout limits:
#    - Hobby plan: 10 seconds default, 60 seconds max
#    - Pro plan: 15 seconds default, 300 seconds max
#    → Keep MONTE_CARLO_SIMULATIONS reasonable

# 4. Memory limit: 1024 MB per function
#    → Monitor memory usage with large datasets

# 5. Cold starts: First request after inactivity may be slow
#    → Consider keeping warm with uptime monitors

# 6. File system is read-only except /tmp directory
#    → Cache directories won't persist between requests

# 7. PDF generation (WeasyPrint) requires system libraries
#    → Vercel buildpack includes these automatically

# 8. For production, upgrade to Pro plan for longer timeouts
#    → Essential for complex predictions with many simulations
