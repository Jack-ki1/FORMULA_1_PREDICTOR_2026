# Season Configuration
SEASON_YEAR=2026
DEBUG=False

# Application bind address. HOST/PORT are the canonical names.
# (The historical FLASK_ENV/FLASK_HOST/FLASK_PORT trio was removed: Flask was
# replaced by FastAPI long ago, but the runtime still read the vestigial pair
# while this file documented it as authoritative. See modify.md 2/3.)
HOST=0.0.0.0
PORT=5000
ENVIRONMENT=development
# REQUIRED in production. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The app refuses to boot with the default value while ENVIRONMENT=production.
SECRET_KEY=change-me-generate-a-real-one
# Admin token for POST /api/v1/settings (X-Admin-Token header).
# If unset, admin-only fields are UNWRITABLE (not writable-with-a-default).
SETTINGS_ADMIN_TOKEN=

# API Base URLs
JOLPICA_BASE_URL=https://api.jolpica.f1
OPENF1_BASE_URL=https://api.openf1.org
FASTF1_CACHE_ENABLED=True
HUGGINGFACE_DATASET=tracinginsights/RaceData

# Cache Configuration
API_CACHE_TTL=300
FASTF1_CACHE_PATH=cache/fastf1_cache
MODEL_CACHE_PATH=cache/model_cache

# Database Configuration
DATABASE_URL=sqlite:///./f1_predictions.db
# For production, use PostgreSQL or MySQL:
# DATABASE_URL=postgresql://user:password@localhost/f1_predictor
# DATABASE_URL=mysql://user:password@localhost/f1_predictor

# Background Scheduler
LIVE_UPDATE_INTERVAL=300
POST_RACE_EVALUATION_ENABLED=True

# Feature Weights (defaults matching JSX sliders)
CHAOS_LEVEL_DEFAULT=50
WET_INFLUENCE_DEFAULT=50
RELIABILITY_INFLUENCE_DEFAULT=50
STRATEGY_AGGRESSIVENESS_DEFAULT=50
GRID_WEIGHT_DEFAULT=55

# Model Configuration
DEFAULT_MODEL_VERSION=v1.0
ENABLE_ENSEMBLE=True
MONTE_CARLO_SIMULATIONS=1000

# Reports
PDF_EXPORT_ENABLED=True
SHARE_CARD_ENABLED=True
