{
  "version": 2,
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "vercel:app",
      "buildCommand": "cd .. && pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1",
      "service": "backend"
    },
    {
      "source": "/health",
      "destination": "/health",
      "service": "backend"
    },
    {
      "source": "/metrics",
      "destination": "/metrics",
      "service": "backend"
    },
    {
      "source": "/docs",
      "destination": "/docs",
      "service": "backend"
    },
    {
      "source": "/redoc",
      "destination": "/redoc",
      "service": "backend"
    },
    {
      "source": "/openapi.json",
      "destination": "/openapi.json",
      "service": "backend"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/$1",
      "service": "backend"
    },
    {
      "source": "/standings/(.*)",
      "destination": "/standings/$1",
      "service": "backend"
    },
    {
      "source": "/h2h/(.*)",
      "destination": "/h2h/$1",
      "service": "backend"
    },
    {
      "source": "/fantasy/(.*)",
      "destination": "/fantasy/$1",
      "service": "backend"
    },
    {
      "source": "/settings/(.*)",
      "destination": "/settings/$1",
      "service": "backend"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/reports/$1",
      "service": "backend"
    },
    {
      "source": "/scenario/(.*)",
      "destination": "/scenario/$1",
      "service": "backend"
    },
    {
      "source": "/live/(.*)",
      "destination": "/live/$1",
      "service": "backend"
    },
    {
      "source": "/grid/(.*)",
      "destination": "/grid/$1",
      "service": "backend"
    },
    {
      "source": "/ai/(.*)",
      "destination": "/ai/$1",
      "service": "backend"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/jobs/$1",
      "service": "backend"
    },
    {
      "source": "/system/(.*)",
      "destination": "/system/$1",
      "service": "backend"
    },
    {
      "source": "/(.*)",
      "destination": "/$1",
      "service": "frontend"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "DEBUG": "false",
    "REDIS_REQUIRED": "false",
    "ENABLE_IN_MEMORY_FALLBACK": "true",
    "LIVE_UPDATE_INTERVAL": "300",
    "HOST": "0.0.0.0",
    "PORT": "5000"
  }
}
