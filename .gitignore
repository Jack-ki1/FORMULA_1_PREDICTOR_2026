# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Environment variables (real secrets/config; .env.example stays tracked)
.env

# Databases (local dev state — not source)
*.db
*.sqlite
*.sqlite3

# Runtime caches (regenerated on demand, not source)
cache/fastf1_cache/
cache/api_responses/*.json
cache/model_cache/

# Editor/OS noise
.DS_Store
.vscode/*
!.vscode/settings.json

# Build artifacts
build/
dist/
*.egg-info/
