# Local dev default — zero setup. Production: a Neon pooled connection
# string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./f1_predictions.db

# The Next.js frontend's origin(s), comma-separated. Include both your
# local dev URL and your deployed Vercel frontend URL.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret with apps/web's AUTH_SYNC_SECRET — must match exactly.
AUTH_SYNC_SECRET=change-me-to-a-long-random-string

# JWT signing secret for the API tokens this service issues after
# apps/web's Auth.js calls /api/auth/sync-user.
SECRET_KEY=change-me-to-a-long-random-string

# Upstash Redis connection string (rediss://...). Leave unset for local
# dev — falls back to an in-memory cache automatically.
REDIS_URL=

DEBUG=False
SEASON_YEAR=2026

# AI "boost"/chat features (optional) — leave blank to disable
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
